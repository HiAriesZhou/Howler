# Single source of truth for app identity. Edit here to rename the app.
# Consumed by scripts/bundle.sh (Info.plist, .app name, zip name).
# The running app reads its display name back from Info.plist (CFBundleName).
APP_NAME="Howler"
BUNDLE_ID="com.hiarieszhou.howler"
VERSION="0.1.12"
BUILD_NUMBER="13"
MIN_MACOS="14.0"
# SwiftPM executable product that gets copied into the bundle (see Package.swift).
EXECUTABLE_PRODUCT="Howler"
# Sparkle updates: the appcast CI attaches to every release, and the public half of the
# EdDSA key that signs it (the private half is the SPARKLE_ED_PRIVATE_KEY secret).
SPARKLE_FEED_URL="https://github.com/HiAriesZhou/Howler/releases/latest/download/appcast.xml"
SPARKLE_PUBLIC_KEY="1mTRvdb/7Ow6TGJykfFpdY/fdTbeWQGRtu4LmDXM7Zc="
