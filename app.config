# Single source of truth for app identity. Edit here to rename the app.
# Consumed by scripts/bundle.sh (Info.plist, .app name, zip name).
# The running app reads its display name back from Info.plist (CFBundleName).
APP_NAME="Howler"
BUNDLE_ID="com.hiarieszhou.howler"
VERSION="0.1.6"
BUILD_NUMBER="7"
MIN_MACOS="14.0"
# SwiftPM executable product that gets copied into the bundle (see Package.swift).
EXECUTABLE_PRODUCT="Howler"
